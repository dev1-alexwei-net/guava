FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build

ARG TARGETOS
ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY fileexplorer/ ./fileexplorer/
RUN mkdir -p /out && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/fileexplorer ./fileexplorer

FROM alpine:3.23

RUN apk add --no-cache ca-certificates
COPY --from=build /out/fileexplorer /usr/local/bin/fileexplorer

WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/fileexplorer"]
