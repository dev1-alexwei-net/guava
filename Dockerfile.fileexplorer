FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS build

ARG TARGETOS
ARG TARGETARCH

# Package version injected into the binary's version package. Defaults to
# "dev" so local docker builds are clearly development builds; the publish
# workflow passes the resolved release version.
ARG VERSION=dev

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY fileexplorer/ ./fileexplorer/
COPY internal/ ./internal/
RUN mkdir -p /out && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X github.com/dev1-alexwei-net/guava/internal/version.SemVer=${VERSION}" -o /out/fileexplorer ./fileexplorer

FROM alpine:3.23

RUN apk add --no-cache ca-certificates
COPY --from=build /out/fileexplorer /usr/local/bin/fileexplorer

WORKDIR /data
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/fileexplorer"]
