{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "pre": "executor."
          }
        }
      ],
      "destination": "/api/executor"
    },
    {
      "source": "/(.*)",
      "destination": "/api/fileexplorer"
    }
  ]
}
